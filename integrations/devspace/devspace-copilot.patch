+
+export interface GitPolicy {
+  protectedBranches: string[];
+  allowCommitToProtectedBranches: boolean;
+  allowPushToProtectedBranches: boolean;
+}
+
+export interface GitRefComparison {
+  ref: string;
+  status: "available" | "no_head" | "ref_unavailable";
+  commit?: string;
+  ahead?: number;
+  behind?: number;
+}
+
+export interface GitWorkspaceStatus {
+  repoRoot: string;
+  head?: string;
+  upstream?: string;
+  upstreamComparison?: GitRefComparison;
+  comparison?: GitRefComparison;
+  refsSource?: "local";
+  branch?: string;
+  workingTreeClean: boolean;
+  modifiedFiles: string[];
+}
+
+export class GitToolError extends Error {
+  constructor(
+    readonly code: string,
+    message: string,
+    readonly status?: GitWorkspaceStatus,
+  ) {
+    super(message);
+    this.name = "GitToolError";
+  }
+}
+
+export async function gitStatus(workspaceRoot: string): Promise<GitWorkspaceStatus> {
+  const repoRoot = await assertWorkspaceRepository(workspaceRoot);
+  const [statusOutput, branch] = await Promise.all([
+    git(repoRoot, ["--no-optional-locks", "status", "--porcelain=v1", "-z"]),
+    currentBranch(repoRoot),
+  ]);
+  const modifiedFiles = porcelainPaths(statusOutput.stdout);
+  return {
+    repoRoot,
+    branch,
+    workingTreeClean: modifiedFiles.length === 0,
+    modifiedFiles,
+  };
+}
+
+/** Inspect cached refs only; never fetch or update a repository. */
+export async function gitInspect(workspaceRoot: string, compareRef = "origin/main"): Promise<GitWorkspaceStatus> {
+  if (!/^[A-Za-z0-9][A-Za-z0-9._/@-]*$/.test(compareRef) || compareRef.includes("..")) {
+    throw new GitToolError("GIT_INVALID_REF", "Comparison must be a branch, ref, or commit ID, not options or a revision expression.");
+  }
+  const status = await gitStatus(workspaceRoot);
+  const head = await resolveCommit(status.repoRoot, "HEAD");
+  const upstream = status.branch
+    ? (await git(status.repoRoot, ["for-each-ref", "--format=%(upstream)", "--", `refs/heads/${status.branch}`])).stdout.trim() || undefined
+    : undefined;
+  const [upstreamComparison, comparison] = await Promise.all([
+    upstream ? compareCachedRef(status.repoRoot, head, upstream) : undefined,
+    compareCachedRef(status.repoRoot, head, compareRef),
+  ]);
+  return { ...status, head, upstream, upstreamComparison, comparison, refsSource: "local" };
+}
+
+async function resolveCommit(repoRoot: string, ref: string): Promise<string | undefined> {
+  try {
+    return (await git(repoRoot, ["rev-parse", "--verify", "--quiet", "--end-of-options", `${ref}^{commit}`])).stdout.trim() || undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+async function compareCachedRef(repoRoot: string, head: string | undefined, ref: string): Promise<GitRefComparison> {
+  if (!head) return { ref, status: "no_head" };
+  const commit = await resolveCommit(repoRoot, ref);
+  if (!commit) return { ref, status: "ref_unavailable" };
+  // Only resolved commit IDs reach rev-list; user input is never a shell command.
+  const counts = (await git(repoRoot, ["rev-list", "--left-right", "--count", `${head}...${commit}`, "--"])).stdout.trim();
+  const match = /^(\d+)\s+(\d+)$/.exec(counts);
+  if (!match) throw new GitToolError("GIT_COMPARISON_FAILED", "Git returned invalid ahead/behind counts.");
+  return { ref, status: "available", commit, ahead: Number(match[1]), behind: Number(match[2]) };
+}
+
+export async function gitFetch(workspaceRoot: string, remote: string): Promise<GitWorkspaceStatus> {
+  const status = await gitStatus(workspaceRoot);
+  await assertRemote(status.repoRoot, remote);
+  await git(status.repoRoot, ["fetch", "--prune", remote]);
+  return gitStatus(workspaceRoot);
+}
+
+export async function gitPull(
+  workspaceRoot: string,
+  remote: string,
+  branch: string,
+): Promise<GitWorkspaceStatus> {
+  const status = await requireCleanWorkspace(workspaceRoot, "pull");
+  await assertRemote(status.repoRoot, remote);
+  await assertBranch(status.repoRoot, branch);
+  try {
+    await git(status.repoRoot, ["pull", "--ff-only", remote, branch]);
+  } catch (error) {
+    throw gitFailure("GIT_PULL_FAILED", "Fast-forward pull failed; no merge or rebase was performed.", status, error);
+  }
+  return gitStatus(workspaceRoot);
+}
+
+export async function gitSwitch(
+  workspaceRoot: string,
+  branch: string,
+  options: { create?: boolean; startPoint?: string } = {},
+): Promise<GitWorkspaceStatus> {
+  const status = await requireCleanWorkspace(workspaceRoot, "switch branches");
+  await assertBranch(status.repoRoot, branch);
+  if (options.create && !branch.startsWith("feature/")) {
+    throw new GitToolError("GIT_FEATURE_BRANCH_REQUIRED", "New branches must use the feature/ prefix.", status);
+  }
+  if (options.startPoint) await assertStartPoint(status.repoRoot, options.startPoint);
+  const args = options.create
+    ? ["switch", "-c", branch, ...(options.startPoint ? [options.startPoint] : [])]
+    : ["switch", branch];
+  try {
+    await git(status.repoRoot, args);
+  } catch (error) {
+    throw gitFailure("GIT_SWITCH_FAILED", "Git could not switch branches.", status, error);
+  }
+  return gitStatus(workspaceRoot);
+}
+
+export async function gitStage(
+  workspaceRoot: string,
+  paths: string[],
+): Promise<GitWorkspaceStatus> {
+  const status = await gitStatus(workspaceRoot);
+  if (paths.length === 0) {
+    throw new GitToolError("GIT_STAGE_PATHS_REQUIRED", "Stage requires one or more workspace-relative paths.", status);
+  }
+  const relativePaths = paths.map((path) => {
+    const absolute = resolveAllowedPath(path, status.repoRoot, [status.repoRoot]);
+    if (!isPathInsideRoot(absolute, status.repoRoot)) {
+      throw new GitToolError("GIT_PATH_OUTSIDE_WORKSPACE", `Path is outside the workspace: ${path}`, status);
+    }
+    return relative(status.repoRoot, absolute) || ".";
+  });
+  await git(status.repoRoot, ["add", "--", ...relativePaths]);
+  return gitStatus(workspaceRoot);
+}
+
+export async function gitCommit(
+  workspaceRoot: string,
+  message: string,
+  policy: GitPolicy,
+): Promise<GitWorkspaceStatus> {
+  const status = await gitStatus(workspaceRoot);
+  assertBranchWritable(status, policy, "commit", policy.allowCommitToProtectedBranches);
+  if (!message.trim()) {
+    throw new GitToolError("GIT_COMMIT_MESSAGE_REQUIRED", "Commit message must not be empty.", status);
+  }
+  try {
+    await git(status.repoRoot, ["commit", "-m", message]);
+  } catch (error) {
+    throw gitFailure("GIT_COMMIT_FAILED", "Git could not create the commit. Stage the intended files first.", status, error);
+  }
+  return gitStatus(workspaceRoot);
+}
+
+export async function gitPush(
+  workspaceRoot: string,
+  remote: string,
+  branch: string | undefined,
+  policy: GitPolicy,
+): Promise<GitWorkspaceStatus> {
+  const status = await gitStatus(workspaceRoot);
+  const targetBranch = branch ?? status.branch;
+  if (!targetBranch) {
+    throw new GitToolError("GIT_BRANCH_REQUIRED", "Push requires a named branch; detached HEAD is not supported.", status);
+  }
+  await assertRemote(status.repoRoot, remote);
+  await assertBranch(status.repoRoot, targetBranch);
+  assertBranchWritable({ ...status, branch: targetBranch }, policy, "push", policy.allowPushToProtectedBranches);
+  try {
+    await git(status.repoRoot, ["push", remote, targetBranch]);
+  } catch (error) {
+    throw gitFailure("GIT_PUSH_FAILED", "Git could not push the branch.", status, error);
+  }
+  return gitStatus(workspaceRoot);
+}
+
+async function requireCleanWorkspace(workspaceRoot: string, operation: string): Promise<GitWorkspaceStatus> {
+  const status = await gitStatus(workspaceRoot);
+  if (!status.workingTreeClean) {
+    throw new GitToolError(
+      "GIT_WORKTREE_DIRTY",
+      `Cannot ${operation}: the working tree has uncommitted changes. No stash, reset, or discard was performed.`,
+      status,
+    );
+  }
+  return status;
+}
+
+async function assertWorkspaceRepository(workspaceRoot: string): Promise<string> {
+  const canonicalWorkspaceRoot = await realpath(workspaceRoot).catch(() => undefined);
+  if (!canonicalWorkspaceRoot) {
+    throw new GitToolError("GIT_WORKSPACE_NOT_FOUND", "Workspace root does not exist.");
+  }
+  let reportedRoot: string;
+  try {
+    reportedRoot = (await git(canonicalWorkspaceRoot, ["rev-parse", "--show-toplevel"])).stdout.trim();
+  } catch {
+    throw new GitToolError("GIT_REPOSITORY_NOT_FOUND", "The opened workspace root is not a Git repository.");
+  }
+  const canonicalGitRoot = await realpath(reportedRoot).catch(() => undefined);
+  if (!canonicalGitRoot || !samePath(canonicalWorkspaceRoot, canonicalGitRoot)) {
+    throw new GitToolError(
+      "GIT_WORKSPACE_ROOT_MISMATCH",
+      "Git operations require the opened workspace root itself to be the repository root; nested, parent, and symlink-escaped repositories are rejected.",
+    );
+  }
+  return canonicalGitRoot;
+}
+
+async function currentBranch(repoRoot: string): Promise<string | undefined> {
+  try {
+    return (await git(repoRoot, ["symbolic-ref", "--quiet", "--short", "HEAD"])).stdout.trim() || undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+async function assertRemote(repoRoot: string, remote: string): Promise<void> {
+  if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(remote)) {
+    throw new GitToolError("GIT_INVALID_REMOTE", "Remote name contains unsupported characters.");
+  }
+  try {
+    await git(repoRoot, ["remote", "get-url", remote]);
+  } catch {
+    throw new GitToolError("GIT_REMOTE_NOT_FOUND", `Git remote does not exist: ${remote}`);
+  }
+}
+
+async function assertBranch(repoRoot: string, branch: string): Promise<void> {
+  if (!branch || branch.startsWith("-") || branch.includes("..")) {
+    throw new GitToolError("GIT_INVALID_BRANCH", "Branch name is invalid.");
+  }
+  try {
+    await git(repoRoot, ["check-ref-format", "--branch", branch]);
+  } catch {
+    throw new GitToolError("GIT_INVALID_BRANCH", "Branch name is invalid.");
+  }
+}
+
+async function assertStartPoint(repoRoot: string, startPoint: string): Promise<void> {
+  if (!/^[A-Za-z0-9][A-Za-z0-9._/@-]*$/.test(startPoint)) {
+    throw new GitToolError("GIT_INVALID_START_POINT", "Branch start point is invalid.");
+  }
+  try {
+    await git(repoRoot, ["rev-parse", "--verify", "--quiet", `${startPoint}^{commit}`]);
+  } catch {
+    throw new GitToolError("GIT_INVALID_START_POINT", "Branch start point does not resolve to a commit.");
+  }
+}
+
+function assertBranchWritable(
+  status: GitWorkspaceStatus,
+  policy: GitPolicy,
+  operation: "commit" | "push",
+  permitted: boolean,
+): void {
+  if (status.branch && policy.protectedBranches.includes(status.branch) && !permitted) {
+    throw new GitToolError(
+      "GIT_PROTECTED_BRANCH",
+      `Direct ${operation} to protected branch ${status.branch} is disabled by policy. Use a feature/* branch and a reviewed PR.`,
+      status,
+    );
+  }
+}
+
+function porcelainPaths(output: string): string[] {
+  const entries = output.split("\0").filter(Boolean);
+  const paths: string[] = [];
+  for (let index = 0; index < entries.length; index += 1) {
+    const entry = entries[index]!;
+    if (entry.length < 4) continue;
+    paths.push(entry.slice(3));
+    if (["R", "C"].includes(entry[0]!) || ["R", "C"].includes(entry[1]!)) index += 1;
+  }
+  return paths;
+}
+
+function samePath(left: string, right: string): boolean {
+  return process.platform === "win32" ? left.toLowerCase() === right.toLowerCase() : left === right;
+}
+
+function gitFailure(code: string, message: string, status: GitWorkspaceStatus, error: unknown): GitToolError {
+  const detail = error instanceof Error ? error.message.replace(/\s+/g, " ").trim() : String(error);
+  return new GitToolError(code, `${message} ${detail}`.slice(0, 1_000), status);
+}
