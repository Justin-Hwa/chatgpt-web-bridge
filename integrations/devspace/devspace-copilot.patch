+function gitToolResponse(
+  tool: string,
+  workspaceId: string,
+  status: GitWorkspaceStatus,
+  startedAt: number,
+  config: ServerConfig,
+) {
+  const result = [
+    `Repository: ${status.repoRoot}`,
+    `Branch: ${status.branch ?? "detached HEAD"}`,
+    status.workingTreeClean
+      ? "Working tree is clean."
+      : `Working tree has uncommitted changes: ${status.modifiedFiles.join(", ")}`,
+    ...(status.refsSource ? [
+      `HEAD: ${status.head ?? "no commit yet"}`,
+      `Upstream: ${status.upstream ?? "not configured (or detached HEAD)"}`,
+      ...[status.upstreamComparison, status.comparison].flatMap((comparison) => comparison ? [
+        comparison.status === "available"
+          ? `Compared with ${comparison.ref}: ahead ${comparison.ahead}, behind ${comparison.behind}.`
+          : `Compared with ${comparison.ref}: ${comparison.status}.`,
+      ] : []),
+      "Counts use local cached refs; no fetch was performed. Remote changes since the last fetch are not included.",
+    ] : []),
+  ].join("\n");
+  logToolCall(config, {
+    tool,
+    workspaceId,
+    success: true,
+    durationMs: Math.round(performance.now() - startedAt),
+  });
+  return {
+    content: [textBlock(result)],
+    _meta: { tool, card: { workspaceId, root: status.repoRoot, summary: status } },
+    structuredContent: { result, ...status },
+  };
+}
+
+function gitToolErrorResponse(
+  tool: string,
+  workspaceId: string,
+  error: unknown,
+  startedAt: number,
+  config: ServerConfig,
+) {
+  const typed = error instanceof GitToolError ? error : undefined;
+  const message = typed?.message ?? (error instanceof Error ? error.message : String(error));
+  logToolCall(config, {
+    tool,
+    workspaceId,
+    success: false,
+    durationMs: Math.round(performance.now() - startedAt),
+    error: message.slice(0, 240),
+  });
+  return {
+    isError: true as const,
+    content: [textBlock(message)],
+    structuredContent: {
+      result: message,
+      code: typed?.code ?? "GIT_OPERATION_FAILED",
+      ...(typed?.status ?? {}),
+    },
+  };
