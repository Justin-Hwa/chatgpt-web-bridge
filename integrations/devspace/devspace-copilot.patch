+  set "DEVSPACE_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1,teams.microsoft.com,global.consent.azure-apim.net"
+)
+node ".\dist\cli.js" serve
+exit /b %errorlevel%
