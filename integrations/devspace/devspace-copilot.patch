diff --git a/src/oauth-resource.test.ts b/src/oauth-resource.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fee236293551ea9a70fc12c2488c5a0ecba6dcdd
--- /dev/null
+++ b/src/oauth-resource.test.ts
@@ -0,0 +1,179 @@
+import assert from "node:assert/strict";
+import { createHash, randomBytes } from "node:crypto";
+import { once } from "node:events";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test, { type TestContext } from "node:test";
+import express from "express";
+import { mcpAuthRouter } from "@modelcontextprotocol/sdk/server/auth/router.js";
+import type { OAuthClientInformationFull, OAuthTokens } from "@modelcontextprotocol/sdk/shared/auth.js";
+import { SingleUserOAuthProvider } from "./oauth-provider.js";
+
+const resource = "https://agent.example.com/mcp";
+const redirectUri = "https://teams.microsoft.com/api/platform/v1.0/oAuthRedirect";
+const ownerToken = "test-owner-password-not-a-real-credential";
+
+async function fixture(t: TestContext, defaultResourceWhenMissing: boolean) {
+  const stateDir = await mkdtemp(join(tmpdir(), "devspace-oauth-resource-"));
+  const provider = new SingleUserOAuthProvider({
+    ownerToken,
+    accessTokenTtlSeconds: 3600,
+    refreshTokenTtlSeconds: 2592000,
+    scopes: ["devspace"],
+    allowedRedirectHosts: ["teams.microsoft.com"],
+    defaultResourceWhenMissing,
+  }, new URL(resource), stateDir);
+  const app = express();
+  app.use(mcpAuthRouter({
+    provider,
+    issuerUrl: new URL("https://agent.example.com"),
+    resourceServerUrl: new URL(resource),
+    scopesSupported: ["devspace"],
+  }));
+  const server = app.listen(0, "127.0.0.1");
+  t.after(async () => {
+    server.closeAllConnections();
+    await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+    provider.close();
+    await rm(stateDir, { recursive: true, force: true });
+  });
+  await once(server, "listening");
+  const address = server.address();
+  assert.ok(address && typeof address !== "string");
+  const base = `http://127.0.0.1:${address.port}`;
+  const request = (path: string, init: RequestInit = {}) =>
+    fetch(base + path, { ...init, redirect: "manual", signal: AbortSignal.timeout(5000) });
+  const registration = await request("/register", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({
+      client_name: "M365 compatibility test",
+      redirect_uris: [redirectUri],
+      grant_types: ["authorization_code", "refresh_token"],
+      response_types: ["code"],
+      token_endpoint_auth_method: "client_secret_post",
+    }),
+  });
+  assert.equal(registration.status, 201);
+  const client = await registration.json() as OAuthClientInformationFull;
+  assert.ok(client.client_secret);
+  const verifier = randomBytes(32).toString("base64url");
+  const params = new URLSearchParams({
+    response_type: "code",
+    client_id: client.client_id,
+    redirect_uri: redirectUri,
+    state: "test-state",
+    scope: "devspace",
+    code_challenge: createHash("sha256").update(verifier).digest("base64url"),
+    code_challenge_method: "S256",
+  });
+  const form = (path: string, fields: URLSearchParams) => request(path, {
+    method: "POST",
+    headers: { "Content-Type": "application/x-www-form-urlencoded" },
+    body: fields,
+  });
+  return { provider, request, form, client, verifier, params };
+}
+
+function authorizationError(response: Response): string | null {
+  assert.equal(response.status, 302);
+  return new URL(response.headers.get("location")!).searchParams.get("error");
+}
+
+test("resource remains mandatory by default; explicit valid resources still work", async t => {
+  const f = await fixture(t, false);
+  assert.equal(authorizationError(await f.request("/authorize?" + f.params)), "invalid_request");
+  const missingPost = new URLSearchParams(f.params);
+  missingPost.set("owner_token", ownerToken);
+  assert.equal(authorizationError(await f.form("/authorize", missingPost)), "invalid_request");
+  f.params.set("resource", resource);
+  const page = await f.request("/authorize?" + f.params);
+  assert.equal(page.status, 200);
+  assert.match(await page.text(), /Owner password/);
+});
+
+test("opt-in missing resource flow preserves approval, PKCE, client auth and token audience", async t => {
+  const f = await fixture(t, true);
+  const page = await f.request("/authorize?" + f.params);
+  assert.equal(page.status, 200);
+  const html = await page.text();
+  assert.match(html, /Owner password/);
+  assert.ok(html.includes(`name="resource" value="${resource}"`));
+
+  for (const wrongResource of ["https://other.example/mcp", "https://agent.example.com/other"]) {
+    const wrong = new URLSearchParams(f.params);
+    wrong.set("resource", wrongResource);
+    assert.equal(authorizationError(await f.request("/authorize?" + wrong)), "invalid_request");
+    wrong.set("owner_token", ownerToken);
+    assert.equal(authorizationError(await f.form("/authorize", wrong)), "invalid_request");
+  }
+  const wrongScope = new URLSearchParams(f.params);
+  wrongScope.set("scope", "admin");
+  assert.equal(authorizationError(await f.request("/authorize?" + wrongScope)), "invalid_request");
+  const noChallenge = new URLSearchParams(f.params);
+  noChallenge.delete("code_challenge");
+  assert.equal(authorizationError(await f.request("/authorize?" + noChallenge)), "invalid_request");
+  const wrongRedirect = new URLSearchParams(f.params);
+  wrongRedirect.set("redirect_uri", "https://other.example/callback");
+  assert.equal((await f.request("/authorize?" + wrongRedirect)).status, 400);
+
+  const approval = new URLSearchParams(f.params);
+  approval.set("owner_token", "wrong-password");
+  const rejected = await f.form("/authorize", approval);
+  assert.equal(rejected.status, 401);
+  assert.equal(rejected.headers.get("location"), null);
+  approval.set("owner_token", ownerToken);
+  // Also exercise a POST without resource: the code must still carry the audience.
+  const accepted = await f.form("/authorize", approval);
+  assert.equal(accepted.status, 302);
+  const callback = new URL(accepted.headers.get("location")!);
+  assert.equal(callback.origin + callback.pathname, redirectUri);
+  assert.equal(callback.searchParams.get("state"), "test-state");
+  const code = callback.searchParams.get("code");
+  assert.ok(code);
+  const exchange = new URLSearchParams({
+    grant_type: "authorization_code",
+    client_id: f.client.client_id,
+    client_secret: f.client.client_secret!,
+    redirect_uri: redirectUri,
+    code,
+    code_verifier: f.verifier,
+  });
+
+  const wrongSecret = new URLSearchParams(exchange);
+  wrongSecret.set("client_secret", "wrong-secret");
+  const secretRejection = await f.form("/token", wrongSecret);
+  assert.equal(secretRejection.status, 400);
+  assert.equal((await secretRejection.json()).error, "invalid_client");
+  const wrongVerifier = new URLSearchParams(exchange);
+  wrongVerifier.set("code_verifier", "wrong-verifier");
+  assert.equal((await f.form("/token", wrongVerifier)).status, 400);
+  const wrongAudience = new URLSearchParams(exchange);
+  wrongAudience.set("resource", "https://other.example/mcp");
+  assert.equal((await f.form("/token", wrongAudience)).status, 400);
+
+  const tokensResponse = await f.form("/token", exchange);
+  assert.equal(tokensResponse.status, 200);
+  const tokens = await tokensResponse.json() as OAuthTokens;
+  assert.ok(tokens.refresh_token);
+  const auth = await f.provider.verifyAccessToken(tokens.access_token);
+  assert.equal(auth.resource?.href, resource);
+  assert.deepEqual(auth.scopes, ["devspace"]);
+  assert.equal((await f.form("/token", exchange)).status, 400, "authorization code is single-use");
+
+  const refresh = new URLSearchParams({
+    grant_type: "refresh_token",
+    client_id: f.client.client_id,
+    client_secret: f.client.client_secret!,
+    refresh_token: tokens.refresh_token,
+  });
+  const badRefresh = new URLSearchParams(refresh);
+  badRefresh.set("resource", "https://other.example/mcp");
+  assert.equal((await f.form("/token", badRefresh)).status, 400);
+  const refreshedResponse = await f.form("/token", refresh);
+  assert.equal(refreshedResponse.status, 200);
+  const refreshed = await refreshedResponse.json() as OAuthTokens;
+  assert.equal((await f.provider.verifyAccessToken(refreshed.access_token)).resource?.href, resource);
+  assert.equal((await f.form("/token", refresh)).status, 400, "refresh token is rotated");
+});
