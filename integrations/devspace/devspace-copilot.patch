+@echo off
+setlocal
+cd /d "%~dp0.."
+if not exist "dist\cli.js" (
+  echo DevSpace has not been built. Run npm run build first.
+  exit /b 1
+)
+set "DEVSPACE_TOOL_MODE=full"
+rem The tunnel connects to DevSpace through a local loopback address.
+set "DEVSPACE_TRUST_PROXY=loopback"
+set "DEVSPACE_OAUTH_DEFAULT_RESOURCE_WHEN_MISSING=1"
+if defined DEVSPACE_OAUTH_ALLOWED_REDIRECT_HOSTS (
+  set "DEVSPACE_OAUTH_ALLOWED_REDIRECT_HOSTS=%DEVSPACE_OAUTH_ALLOWED_REDIRECT_HOSTS%,teams.microsoft.com,global.consent.azure-apim.net"
