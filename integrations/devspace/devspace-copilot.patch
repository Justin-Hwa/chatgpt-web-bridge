--- /dev/null
+++ b/src/git-tools.test.ts
@@ -0,0 +1,131 @@
+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import { mkdtemp, mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test, { type TestContext } from "node:test";
+import { promisify } from "node:util";
+import { GitToolError, gitCommit, gitFetch, gitInspect, gitPull, gitPush, gitStage, gitStatus, gitSwitch, type GitPolicy } from "./git-tools.js";
+
+const execFileAsync = promisify(execFile);
+const protectedPolicy: GitPolicy = { protectedBranches: ["main"], allowCommitToProtectedBranches: false, allowPushToProtectedBranches: false };
+
+test("controlled Git tools fetch, ff-pull, protect dirty/diverged checkouts, and push a feature branch", async (t) => {
+  const fixture = await createFixture(t);
+  const remoteHead = await remoteCommit(fixture, "remote-one.txt", "one\n", "remote update");
+  await gitFetch(fixture.work, "origin");
+  assert.equal(await gitText(fixture.work, ["rev-parse", "origin/main"]), remoteHead);
+  const pulled = await gitPull(fixture.work, "origin", "main");
+  assert.equal(pulled.workingTreeClean, true);
+  assert.equal(await gitText(fixture.work, ["rev-parse", "HEAD"]), remoteHead);
+
+  await writeFile(join(fixture.work, "dirty.txt"), "do not discard\n");
+  await assertGitError(() => gitPull(fixture.work, "origin", "main"), "GIT_WORKTREE_DIRTY");
+  assert.equal(await readFile(join(fixture.work, "dirty.txt"), "utf8"), "do not discard\n");
+  await rm(join(fixture.work, "dirty.txt"));
+
+  await git(fixture.work, ["commit", "--allow-empty", "-m", "local divergence"]);
+  await remoteCommit(fixture, "remote-two.txt", "two\n", "remote divergence");
+  await assertGitError(() => gitPull(fixture.work, "origin", "main"), "GIT_PULL_FAILED");
+  assert.equal((await gitText(fixture.work, ["rev-list", "--parents", "-n", "1", "HEAD"])).split(" ").length, 2);
+
+  await git(fixture.work, ["reset", "--hard", "origin/main"]);
+  await gitSwitch(fixture.work, "feature/controlled-tools", { create: true });
+  await writeFile(join(fixture.work, "feature.txt"), "feature\n");
+  await gitStage(fixture.work, ["feature.txt"]);
+  await gitCommit(fixture.work, "Add controlled Git tool fixture", protectedPolicy);
+  await gitPush(fixture.work, "origin", "feature/controlled-tools", protectedPolicy);
+  assert.match(await gitText(fixture.work, ["ls-remote", "--heads", "origin", "feature/controlled-tools"]), /refs\/heads\/feature\/controlled-tools/);
+});
+
+test("controlled Git tools reject a nested workspace and direct commits to main", async (t) => {
+  const fixture = await createFixture(t);
+  const nested = join(fixture.work, "nested");
+  await mkdir(nested);
+  await assertGitError(() => gitStatus(nested), "GIT_WORKSPACE_ROOT_MISMATCH");
+  await writeFile(join(fixture.work, "main-change.txt"), "x\n");
+  await gitStage(fixture.work, ["main-change.txt"]);
+  await assertGitError(() => gitCommit(fixture.work, "Blocked main commit", protectedPolicy), "GIT_PROTECTED_BRANCH");
+});
+
+test("read-only inspection reports cached upstream divergence without touching files, refs or index", async (t) => {
+  const fixture = await createFixture(t);
+  await remoteCommit(fixture, "upstream.txt", "upstream\n", "upstream");
+  const stale = await gitInspect(fixture.work);
+  assert.equal(stale.comparison?.behind, 0, "inspection must not fetch unseen remote changes");
+  await gitFetch(fixture.work, "origin");
+  await git(fixture.work, ["commit", "--allow-empty", "-m", "local divergence"]);
+  await writeFile(join(fixture.work, "dirty.txt"), "keep this file\n");
+  const refsBefore = await gitText(fixture.work, ["show-ref"]);
+  const indexBefore = await readFile(join(fixture.work, ".git", "index"));
+  const status = await gitInspect(fixture.work);
+  assert.equal(status.branch, "main");
+  assert.equal(status.upstream, "refs/remotes/origin/main");
+  assert.equal(status.refsSource, "local");
+  assert.equal(status.workingTreeClean, false);
+  assert.deepEqual(status.modifiedFiles, ["dirty.txt"]);
+  for (const comparison of [status.comparison, status.upstreamComparison]) {
+    assert.equal(comparison?.status, "available");
+    assert.equal(comparison?.ahead, 1);
+    assert.equal(comparison?.behind, 1);
+  }
+  assert.equal(await gitText(fixture.work, ["show-ref"]), refsBefore);
+  assert.deepEqual(await readFile(join(fixture.work, ".git", "index")), indexBefore);
+  assert.equal(await readFile(join(fixture.work, "dirty.txt"), "utf8"), "keep this file\n");
+  const same = await gitInspect(fixture.work, "HEAD");
+  assert.equal(same.comparison?.ahead, 0);
+  assert.equal(same.comparison?.behind, 0);
+});
+
+test("read-only inspection handles missing refs, detached HEAD and unconfigured upstream", async (t) => {
+  const fixture = await createFixture(t);
+  const missing = await gitInspect(fixture.work, "origin/missing");
+  assert.equal(missing.comparison?.status, "ref_unavailable");
+  assert.equal(missing.comparison?.ahead, undefined);
+  await git(fixture.work, ["branch", "--unset-upstream"]);
+  assert.equal((await gitInspect(fixture.work)).upstream, undefined);
+  await git(fixture.work, ["switch", "--detach", "HEAD"]);
+  const detached = await gitInspect(fixture.work);
+  assert.equal(detached.branch, undefined);
+  assert.ok(detached.head);
+  assert.equal(detached.upstream, undefined);
+  assert.equal(detached.comparison?.status, "available");
+  for (const ref of ["--all", "HEAD...main", "HEAD;echo bad", "@{upstream}"]) {
+    await assertGitError(() => gitInspect(fixture.work, ref), "GIT_INVALID_REF");
+  }
+  const nested = join(fixture.work, "nested");
+  await mkdir(nested);
+  await assertGitError(() => gitInspect(nested), "GIT_WORKSPACE_ROOT_MISMATCH");
+});
+
+test("read-only inspection reports an unborn branch without inventing counts", async (t) => {
+  const root = await mkdtemp(join(tmpdir(), "devspace-git-unborn-"));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  await git(root, ["init", "-b", "main"]);
+  const status = await gitInspect(root);
+  assert.equal(status.branch, "main");
+  assert.equal(status.head, undefined);
+  assert.equal(status.comparison?.status, "no_head");
+  assert.equal(status.comparison?.ahead, undefined);
+});
+
+async function createFixture(t: TestContext): Promise<{ root: string; work: string; author: string }> {
+  const root = await mkdtemp(join(tmpdir(), "devspace-git-tools-"));
+  const remote = join(root, "remote.git"); const seed = join(root, "seed"); const work = join(root, "work"); const author = join(root, "author");
+  t.after(() => rm(root, { recursive: true, force: true }));
+  await git(root, ["init", "--bare", remote]); await git(root, ["init", "-b", "main", seed]); await configure(seed);
+  await writeFile(join(seed, "README.md"), "seed\n"); await git(seed, ["add", "README.md"]); await git(seed, ["commit", "-m", "Initial commit"]);
+  await git(seed, ["remote", "add", "origin", remote]); await git(seed, ["push", "-u", "origin", "main"]);
+  await git(root, ["clone", remote, work]); await git(root, ["clone", remote, author]); await configure(work); await configure(author);
+  await git(work, ["switch", "main"]); await git(author, ["switch", "main"]);
+  return { root, work, author };
+}
+
+async function remoteCommit(fixture: { author: string }, path: string, content: string, message: string): Promise<string> {
+  await writeFile(join(fixture.author, path), content); await git(fixture.author, ["add", path]); await git(fixture.author, ["commit", "-m", message]); await git(fixture.author, ["push", "origin", "main"]);
+  return gitText(fixture.author, ["rev-parse", "HEAD"]);
+}
+async function configure(cwd: string): Promise<void> { await git(cwd, ["config", "user.email", "devspace-tests@example.com"]); await git(cwd, ["config", "user.name", "DevSpace Tests"]); }
+async function assertGitError(action: () => Promise<unknown>, code: string): Promise<void> { await assert.rejects(action, (error: unknown) => error instanceof GitToolError && error.code === code); }
+async function git(cwd: string, args: string[]): Promise<void> { await execFileAsync("git", args, { cwd }); }
+async function gitText(cwd: string, args: string[]): Promise<string> { return (await execFileAsync("git", args, { cwd })).stdout.trim(); }
