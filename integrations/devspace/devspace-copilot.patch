+    assert.equal(trust("198.51.100.42"), false);
+    const headers = {
+      "X-Forwarded-For": "203.0.113.99, 198.51.100.42",
+      "CF-Connecting-IP": "203.0.113.99",
+    };
+    const response = await fetch(`${base}/proxy-test`, { headers });
