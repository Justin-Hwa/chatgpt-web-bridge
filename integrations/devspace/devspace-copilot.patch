+  // the checkout fields optional so an unknown workspace can return only a
+  // stable error code, while dirty-worktree errors can include their status.
+  code: z.string().optional(),
+  repoRoot: z.string().optional(),
+  branch: z.string().optional(),
+  workingTreeClean: z.boolean().optional(),
+  modifiedFiles: z.array(z.string()).optional(),
+  head: z.string().optional(),
